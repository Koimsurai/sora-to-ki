# Backend secrets and integrations: copy to .env.backend (docker-compose.yml reads it via env_file).
# Site identity (URL, name, author) does not go here but in .env; see the ⚠️ in docker-compose.yml for why.
#
# Apart from the "Required" section, every group can be left empty as a whole: an integration that isn't
# set stays off, and its section shows as empty.

# ── Required ─────────────────────────────────────────────────────────
# JWT signing secret (a long random string, e.g. `openssl rand -hex 32`). Changing it signs everyone out.
JWT_SECRET=

# ── Site owner ───────────────────────────────────────────────────────
# The admin is reached only by signing in with GitHub or Google (set at least one pair under "Sign-in" below).
# Empty: on first boot the log prints `setup: open …/admin/init?code=…`; open it to claim the site and set
#        the languages, site name and pages along the way (`docker compose logs backend-rs | grep setup`).
# Set: whoever signs in with this email is the owner, and the first-time setup is skipped.
OWNER_EMAIL=

# Pages to turn off on first boot, comma-separated: moments,works,collection,setup,log,messages,photos,friends,colophon.
# Written to the site settings on first boot only; change it later in the admin or via MCP.
# ⚠ Leave it commented = the default (setup and photos off: one needs a blueprint picked first, the other a
#   photo source). Uncommented but empty = no page turned off, not "use the default".
# SITE_DISABLED_PAGES=setup,photos

# ── Machine account for MCP / agents ──────────────────────────────────
# Not for signing in to the admin: packages/mcp-server exchanges it for a token. Created at startup only
# while the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Sign-in (owner into the admin, readers for comments) ──────────────
# Set the callback URL to <SITE_URL>/auth/callback on both. The first-time setup wizard walks you through it
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub (home page activity, works page, contribution graph) ───────
GITHUB_TOKEN=
# Repos for the works page, comma-separated owner/repo, in the order they appear
GITHUB_WORKS=

# ── Newsletter and friend-request replies (Resend) ────────────────────
RESEND_API_KEY=
# Sender; the domain must be verified in Resend first, e.g. Site Name <hello@send.example.com>
NEWSLETTER_FROM=
# Where readers' "Reply" goes (the sending domain usually can't receive mail)
NEWSLETTER_REPLY_TO=

# ── Collection: watching ─────────────────────────────────────────────
# TMDB API Read Access Token (posters and titles)
TMDB_API_TOKEN=
# Simkl watch history. Synced periodically only with ENABLE_SIMKL_SYNC=1
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=
# The app name registered on Simkl (defaults to sora-to-ki)
SIMKL_APP_NAME=
ENABLE_SIMKL_SYNC=
# Bahamut Anime Crazy (Taiwan). Synced only with ENABLE_BAHAMUT_SYNC=1
BAHAMUT_UID=
BAHAMUT_PASSWORD=
ENABLE_BAHAMUT_SYNC=

# ── Collection: reading ──────────────────────────────────────────────
# Book lookup by ISBN. Works without a key (Open Library); a key gives a larger quota
GOOGLE_BOOKS_API_KEY=
# National Central Library new-book ISBN index (books published in Taiwan), refreshed daily with ENABLE_TW_ISBN_SYNC=1
ENABLE_TW_ISBN_SYNC=

# ── Collection: listening, playing, coding ────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
STEAM_API_KEY=
STEAM_ID=
WAKATIME_API_KEY=

# ── Traffic page in the admin ────────────────────────────────────────
# Plausible Stats API key. If you self-host Plausible, also set PLAUSIBLE_BASE_URL (default https://plausible.io)
PLAUSIBLE_API_KEY=
PLAUSIBLE_BASE_URL=
# The site name in Plausible; defaults to the host of SITE_URL
PLAUSIBLE_SITE_ID=
# Google Search Console: path inside the container to the service-account JSON key (mount it yourself)
GSC_SERVICE_ACCOUNT_FILE=

# ── Error reporting (Sentry-compatible, e.g. GlitchTip) ───────────────
SENTRY_DSN=
# The frontend's real DSN, known only to the backend (frontend reports are relayed through it)
SENTRY_FRONTEND_DSN=
