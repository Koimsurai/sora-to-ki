# 後端的金鑰與整合：複製成 .env.backend（docker-compose.yml 用 env_file 讀它）。
# 站台身分（網址、站名、作者）不放這裡，放 .env——理由見 docker-compose.yml 的 ⚠️。
#
# 除了「必填」那一段，每一組都可以整組留空：沒設的整合就不啟用，對應的區塊顯示空的。

# ── 必填 ─────────────────────────────────────────────────────────
# JWT 簽章密鑰（隨機長字串，例如 `openssl rand -hex 32`）。換掉會讓所有人被登出。
JWT_SECRET=

# ── 站長 ─────────────────────────────────────────────────────────
# 進後台只能用 GitHub 或 Google 登入（下面「登入」那一段至少要設一組）。
# 留空：第一次開機會在 log 印一行 `setup: open …/admin/init?code=…`，打開它認領站長，
#       順便設好語系、站名與要開的頁面（`docker compose logs backend-rs | grep setup`）。
# 填了：用這個信箱登入的人就是站長，不走初次設定。
OWNER_EMAIL=

# 第一次開機要關掉的頁面，逗號分隔：moments,works,collection,setup,log,messages,photos,friends,colophon。
# 只在第一次寫進站台設定，之後在後台或 MCP 改。
# ⚠ 保持註解＝預設（關掉設備與照片：一個要先選圖紙，一個要先接相片來源）。取消註解但留空＝一頁都不關，不是「用預設」。
# SITE_DISABLED_PAGES=setup,photos

# ── MCP／agent 用的機器帳號 ────────────────────────────────────────
# 不是給人登入後台用的：packages/mcp-server 拿它換 token。啟動時 users 表是空的才會建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 登入（站長進後台、讀者留言）────────────────────────────────────
# 回呼網址兩邊都填 <SITE_URL>/auth/callback。一步一步的設定方式在初次設定的精靈裡
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub（首頁動態、作品頁、貢獻圖）──────────────────────────────
GITHUB_TOKEN=
# 作品頁要列的 repo，逗號分隔的 owner/repo，順序就是作品頁的順序
GITHUB_WORKS=

# ── 電子報與友鏈回信（Resend）──────────────────────────────────────
RESEND_API_KEY=
# 寄件人，網域要先在 Resend 驗證過，例如：站名 <hello@send.example.com>
NEWSLETTER_FROM=
# 讀者按「回覆」寄到哪（寄件網域通常收不了信）
NEWSLETTER_REPLY_TO=

# ── 收藏：在看 ───────────────────────────────────────────────────
# TMDB 的 API Read Access Token（海報與片名）
TMDB_API_TOKEN=
# Simkl 觀看紀錄。ENABLE_SIMKL_SYNC=1 才會定期同步
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=
# 在 Simkl 註冊的 app 名稱（沒設就用 sora-to-ki）
SIMKL_APP_NAME=
ENABLE_SIMKL_SYNC=
# 巴哈姆特動畫瘋（台灣）。ENABLE_BAHAMUT_SYNC=1 才會同步
BAHAMUT_UID=
BAHAMUT_PASSWORD=
ENABLE_BAHAMUT_SYNC=

# ── 收藏：在讀 ───────────────────────────────────────────────────
# 用 ISBN 查書目。沒設也能查（Open Library），有 key 額度比較寬
GOOGLE_BOOKS_API_KEY=
# 國家圖書館新書書目索引（台灣出版的書），ENABLE_TW_ISBN_SYNC=1 才會每天更新
ENABLE_TW_ISBN_SYNC=

# ── 收藏：在聽、在玩、在寫 ─────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
STEAM_API_KEY=
STEAM_ID=
WAKATIME_API_KEY=

# ── 後台的流量頁 ─────────────────────────────────────────────────
# Plausible Stats API key。自架的話再設 PLAUSIBLE_BASE_URL（預設 https://plausible.io）
PLAUSIBLE_API_KEY=
PLAUSIBLE_BASE_URL=
# Plausible 裡的站台名稱，沒設就用 SITE_URL 的 host
PLAUSIBLE_SITE_ID=
# Google Search Console：服務帳號 JSON 金鑰在容器裡的路徑（要自己掛進去）
GSC_SERVICE_ACCOUNT_FILE=

# ── 錯誤上報（Sentry 相容，例如 GlitchTip）─────────────────────────
SENTRY_DSN=
# 前端的真 DSN，只有後端知道（前端的報告經後端轉送）
SENTRY_FRONTEND_DSN=
