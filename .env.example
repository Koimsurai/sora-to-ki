# Site settings: copy to .env. docker compose reads this file automatically; frontend and backend share it.
# Backend secrets and integrations go in a separate file: .env.backend (template: .env.backend.example).

# ── Public address (you must change this) ────────────────────────────
# The public URL, without a trailing /. RSS, the sitemap, links in emails and share images all use it.
SITE_URL=https://example.com
# Where the bundled Caddy listens: a domain (no https://) gets an HTTPS certificate automatically, and
# ports 80 and 443 must be reachable from outside. For a local trial or behind another proxy, use :80
# (plain HTTP) and set SITE_URL to http://localhost
CADDY_ADDRESS=example.com

# ── Site identity (written to the site settings on first boot only; change it later in the admin or via MCP) ──
# Site name: RSS title, email signature, the brand text on share images
SITE_NAME=My Site
# Author name: default author of posts, RSS <author>. Falls back to the site name
SITE_AUTHOR=
# One-line description, RSS <description>. Falls back to the site name
SITE_DESCRIPTION=
# Public contact email: the "email me" link in the menu, messages page and friends page. Hidden if unset
SITE_EMAIL=
# GitHub username (not a URL): the menu link and the contribution graph on the log page. Hidden if unset
SITE_GITHUB=

# ── Languages (used until the site settings are changed; after an MCP/admin change, the settings win) ──
# Default language: URLs without a prefix, the source language of posts, the fallback when a translation
# is missing. One of zh-TW, zh-CN, en, ja, ko.
# ⚠ Changing it after launch changes every URL on the site; pick it right the first time
SITE_DEFAULT_LOCALE=zh-TW
# Which languages to enable, comma-separated (the default is always included). Only one = no language
# menu. Empty = all
SITE_LOCALES=

# Time zone (affects the log and scheduled posts)
TZ=Asia/Taipei

# Which release to run: a version number (e.g. 0.2.0) or latest.
# To upgrade, change this, then `docker compose pull && docker compose up -d`
SORA_TO_KI_VERSION=latest

# ── Optional ─────────────────────────────────────────────────────────
# Secret that lets the backend purge the frontend cache right after a post or settings change (same
# value on both sides, a long random string). Can stay empty: the backend generates one on first boot
# and shares it with the frontend through the revalidate-key volume
REVALIDATE_SECRET=

# Plausible analytics: the pa-XXXX.js URL from the admin snippet. No tracking script if unset
VITE_PLAUSIBLE_SCRIPT=

# Frontend DSN for error reporting (Sentry-compatible, e.g. GlitchTip). No reporting if unset
VITE_SENTRY_DSN=
